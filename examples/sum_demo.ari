// aricode-collections-vec: examples/sum_demo.ari
//
// Build a vector, push some numbers, sum them with vec_sum.
//
// Compile: aric examples/sum_demo.ari -o sum_demo
// Run:     ./sum_demo

import "../vec.ari" as vec;

fn main() -> i32 {
    let v: i32 = vec.vec_new();
    vec.vec_push(v, 10);
    vec.vec_push(v, 20);
    vec.vec_push(v, 30);
    vec.vec_push(v, 40);

    print_str("len:");  print_int(vec.vec_len(v));   // 4
    print_str("sum:");  print_int(vec.vec_sum(v));   // 100
    print_str("v[2]:"); print_int(vec.vec_get(v, 2));// 30

    mem_free(v);
    return 0;
}
